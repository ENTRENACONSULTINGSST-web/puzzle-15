const config = {
    type: Phaser.AUTO,
    width: 540,
    height: 750, // Aumentamos un poco el alto para los botones
    backgroundColor: "#111",
    scene: { preload, create }
};

const game = new Phaser.Game(config);

const GRID = 4;
const SIZE = 125; 
const GAP = 2;   
const OFFSET_X = 20;
const OFFSET_Y = 200; // Bajamos el tablero para dar espacio a los botones
const MAX_TIME = 180; // 3 minutos

let pieces = [];
let empty = { row: 3, col: 3 };
let isGameOver = false;
let timeElapsed = 0;
let timerText;
let timerEvent;
let btnShowSolution; // Botón para ver imagen completa

function preload() {
    this.load.image("photo", "assets/imagen.jpg");
}

function create() {
    const texture = this.textures.get("photo");
    const baseImg = texture.getSourceImage();
    
    // Dimensiones reales (4080 x 3072)
    const realW = baseImg.width;
    const realH = baseImg.height;

    // Ajuste de recorte cuadrado centrado
    const sizeToCrop = realH; 
    const startX = (realW - realH) / 2;
    const step = sizeToCrop / GRID;

    // Crear frames para las piezas y uno extra para la solución completa
    for (let r = 0; r < GRID; r++) {
        for (let c = 0; c < GRID; c++) {
            let index = r * GRID + c;
            texture.add(index, 0, startX + (c * step), r * step, step, step);
        }
    }
    // Frame especial (ID: 99) que es el cuadrado completo central
    texture.add(99, 0, startX, 0, sizeToCrop, sizeToCrop);

    // Dibujar el tablero
    for (let row = 0; row < GRID; row++) {
        pieces[row] = [];
        for (let col = 0; col < GRID; col++) {
            if (row === 3 && col === 3) {
                pieces[row][col] = null;
                continue;
            }

            const x = OFFSET_X + col * (SIZE + GAP);
            const y = OFFSET_Y + row * (SIZE + GAP);

            const piece = this.add.image(x, y, "photo", row * GRID + col).setOrigin(0);
            piece.setDisplaySize(SIZE, SIZE);
            const border = this.add.rectangle(x, y, SIZE, SIZE).setOrigin(0).setStrokeStyle(1, 0xffffff, 0.2);

            piece.setInteractive({ useHandCursor: true });
            piece.row = row;
            piece.col = col;
            piece.correctRow = row;
            piece.correctCol = col;
            piece.border = border;

            piece.on("pointerdown", () => movePiece.call(this, piece));
            pieces[row][col] = piece;
        }
    }

    // --- INTERFAZ ---
    
    // Cronómetro
    timerText = this.add.text(OFFSET_X, 50, `Tiempo: 0 / ${MAX_TIME}s`, { 
        fontSize: '32px', 
        fill: '#fff', 
        fontFamily: 'Courier New', 
        fontWeight: 'bold' 
    });

    // Botón REINICIAR
    const btnReset = createButton(this, 420, 65, "REINICIAR", 0xcc0000, () => {
        location.reload();
    });

    // Botón VER SOLUCIÓN (Invisble al inicio)
    btnShowSolution = createButton(this, 270, 140, "VER IMAGEN COMPLETA", 0x444444, () => {
        showFullImage.call(this);
    });
    btnShowSolution.setVisible(false);

    // Lógica del Reloj
    timerEvent = this.time.addEvent({
        delay: 1000,
        callback: () => {
            if (!isGameOver) {
                timeElapsed++;
                timerText.setText(`Tiempo: ${timeElapsed} / ${MAX_TIME}s`);
                
                if (timeElapsed >= MAX_TIME) {
                    endGameByTime.call(this);
                }
            }
        },
        loop: true
    });

    shuffleBoard.call(this);
}

// Función auxiliar para crear botones
function createButton(scene, x, y, label, color, callback) {
    const container = scene.add.container(x, y);
    const bg = scene.add.rectangle(0, 0, 220, 45, color).setInteractive({ useHandCursor: true });
    const txt = scene.add.text(0, 0, label, { fontSize: '14px', fill: '#fff', fontWeight: 'bold' }).setOrigin(0.5);
    container.add([bg, txt]);
    bg.on("pointerdown", callback);
    return container;
}

function endGameByTime() {
    isGameOver = true;
    timerText.setText("¡TIEMPO AGOTADO!").setFill("#ff0000");
    btnShowSolution.setVisible(true); // Aparece el botón al perder
    // Bloquear interacción de piezas
    pieces.forEach(row => row.forEach(p => { if(p) p.disableInteractive(); }));
}

function showFullImage() {
    // Creamos una imagen que tapa todo el puzzle
    const solutionImg = this.add.image(OFFSET_X, OFFSET_Y, "photo", 99).setOrigin(0);
    const totalSize = (SIZE * GRID) + (GAP * (GRID - 1));
    solutionImg.setDisplaySize(totalSize, totalSize);
    solutionImg.setDepth(100); // Poner al frente de todo
    
    // Cambiar texto
    this.add.text(270, OFFSET_Y + totalSize + 30, "ESTA ERA LA IMAGEN", { 
        fontSize: '20px', fill: '#00ff00' 
    }).setOrigin(0.5);
}

function movePiece(piece) {
    if (isGameOver) return;
    const dRow = Math.abs(piece.row - empty.row);
    const dCol = Math.abs(piece.col - empty.col);

    if ((dRow === 1 && dCol === 0) || (dRow === 0 && dCol === 1)) {
        const oldR = piece.row;
        const oldC = piece.col;
        pieces[empty.row][empty.col] = piece;
        pieces[oldR][oldC] = null;
        piece.row = empty.row;
        piece.col = empty.col;
        empty.row = oldR;
        empty.col = oldC;

        this.tweens.add({
            targets: [piece, piece.border],
            x: OFFSET_X + piece.col * (SIZE + GAP),
            y: OFFSET_Y + piece.row * (SIZE + GAP),
            duration: 150,
            ease: 'Cubic.easeOut',
            onComplete: () => checkWin.call(this)
        });
    }
}

function shuffleBoard() {
    for (let i = 0; i < 100; i++) {
        const neighbors = [];
        const dirs = [[-1,0], [1,0], [0,-1], [0,1]];
        dirs.forEach(d => {
            const nr = empty.row + d[0], nc = empty.col + d[1];
            if (nr >= 0 && nr < 4 && nc >= 0 && nc < 4 && pieces[nr][nc]) neighbors.push(pieces[nr][nc]);
        });
        const p = Phaser.Utils.Array.GetRandom(neighbors);
        const or = p.row, oc = p.col;
        pieces[empty.row][empty.col] = p; pieces[or][oc] = null;
        p.row = empty.row; p.col = empty.col; empty.row = or; empty.col = oc;
        const nx = OFFSET_X + p.col * (SIZE + GAP), ny = OFFSET_Y + p.row * (SIZE + GAP);
        p.setPosition(nx, ny); p.border.setPosition(nx, ny);
    }
}

function checkWin() {
    let matches = 0;
    for (let r = 0; r < GRID; r++) {
        for (let c = 0; c < GRID; c++) {
            const p = pieces[r][c];
            if (p && p.row === p.correctRow && p.col === p.correctCol) matches++;
        }
    }
    if (matches === 15) {
        isGameOver = true;
        timerText.setText(`¡GANASTE!`).setFill("#00ff00");
    }
}
